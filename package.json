{
  "name": "firestore-rules-dsl",
  "version": "0.1.0",
  "description": "Strongly typed DSL to generate Firebase Firestore Security Rules",
  "type": "module",
  "author": {
    "name": "Huafu Gandon",
    "email": "huafu.gandon@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huafu/firestore-rules-dsl.git"
  },
  "keywords": [
    "firestore",
    "firebase",
    "security-rules",
    "dsl",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "commitlint": "commitlint --last --verbose",
    "commitlint:branch": "commitlint --from origin/develop --to HEAD --verbose",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:tarball-integration": "tsx scripts/test-tarball-integration.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20",
    "@commitlint/config-conventional": "^20",
    "@eslint/js": "^10",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10",
    "globals": "^17",
    "jiti": "^2",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vitest": "^4"
  }
}
