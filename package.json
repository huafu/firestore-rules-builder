{
  "name": "firestore-rules-dsl",
  "version": "1.2.0",
  "description": "Strongly typed DSL to generate Firebase Firestore Security Rules",
  "type": "module",
  "author": {
    "name": "Huafu Gandon",
    "email": "huafu.gandon@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huafu/firestore-rules-dsl.git"
  },
  "keywords": [
    "firestore",
    "firebase",
    "security-rules",
    "dsl",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "import": "./dist/ast.js",
      "require": "./dist/ast.cjs"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder.js",
      "require": "./dist/builder.cjs"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library.js",
      "require": "./dist/library.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./typesaurus": {
      "types": "./dist/typesaurus/index.d.ts",
      "import": "./dist/typesaurus.js",
      "require": "./dist/typesaurus.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "commitlint": "commitlint --last --verbose",
    "commitlint:branch": "commitlint --from origin/develop --to HEAD --verbose",
    "demo:build": "pnpm --filter firestore-rules-dsl-demo build",
    "demo:dev": "pnpm --filter firestore-rules-dsl-demo dev",
    "demo:preview": "pnpm --filter firestore-rules-dsl-demo preview",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "check:exports": "tsx scripts/check-package-exports.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20",
    "@commitlint/config-conventional": "^20",
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "eslint": "^10",
    "globals": "^17",
    "jiti": "^2",
    "prettier": "^3",
    "tsx": "^4",
    "typesaurus": "^10",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^4"
  },
  "peerDependencies": {
    "typesaurus": "^10"
  },
  "peerDependenciesMeta": {
    "typesaurus": {
      "optional": true
    }
  }
}
