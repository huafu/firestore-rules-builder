exports[`builder > omits section comments when stripComments is enabled 1`] = `
"rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
    }
  }
}"
`;

exports[`builder > renders nested matches and allow statements 1`] = `
"// Firestore Security Rules generated by firestore-rules-dsl
// DO NOT EDIT THIS FILE DIRECTLY. Edit the TypeScript source and regenerate.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ====[ users ]================================================================================
    match /users/{userId} {
      allow read: if true;

      // ====[ users / posts ]======================================================================
      match /posts/{postId} {
        allow create: if true;
      } // End of users / posts
    } // End of users
  } // End of rules
} // End of service definition"
`;
