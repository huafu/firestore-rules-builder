// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`root barrel real-world integration > comprehensive rules using all context helpers and methods 1`] = `
"rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(ownerId) {
      return request.auth.uid == ownerId;
    }
    function isSignedIn() {
      return request.auth.uid is string;
    }
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    function isMemberOfOrg(orgId) {
      return request.auth.token.orgId == orgId;
    }
    function notExpired(expiresAt) {
      return request.time < expiresAt;
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isSignedIn();
      allow create: if isSignedIn() && resource.data.createdAt == request.time;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }
    match /orgs/{orgId} {
      allow read: if isMemberOfOrg(orgId);
      allow create: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource.data.plan == 'free';
      allow update: if isAdmin() || isOwner(resource.data.ownerId);
      allow delete: if isAdmin();
      match /projects/{projectId} {
        allow read: if resource.data.public == true || isMemberOfOrg(orgId) && resource.data.status == 'active';
        allow create: if isMemberOfOrg(orgId) && resource.data.ownerId == request.auth.uid && resource.data.status == 'active';
        allow update: if isOwner(resource.data.ownerId) || isAdmin() && !(resource.data.status == 'deleted');
        allow delete: if isOwner(resource.data.ownerId);
      }
      match /invites/{inviteId} {
        allow read: if isMemberOfOrg(orgId) && notExpired(resource.data.expiresAt);
        allow create: if isMemberOfOrg(orgId) && resource.data.expiresAt > request.time && resource.data.expiresAt <= request.time + 2592000;
        allow delete: if notExpired(resource.data.expiresAt) && isOwner(resource.data.createdBy);
      }
    }
  }
}
"
`;
