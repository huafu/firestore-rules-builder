exports[`createFirestoreRulesBuilder > should render rules correctly 1`] = `
"// Firestore Security Rules generated by firestore-rules-dsl
// DO NOT EDIT THIS FILE DIRECTLY. Edit the TypeScript source and regenerate.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ****[ HELPERS ]******************************************************************************

    // ====[ isAuthenticated ]======================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // ====[ hasClaim ]=============================================================================
    function hasClaim(claim, expected) {
      return request.auth.token[claim] == expected;
    }

    // ****[ RULES ]********************************************************************************

    // ====[ users ]================================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    } // End of users

    // ====[ posts ]================================================================================
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if (
        isAuthenticated() && request.auth.uid == resource.data.authorId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["title","content","updatedAt"])
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if (
        isAuthenticated()
        && (
          request.auth.uid == resource.data.authorId
          || request.auth.token.admin == true
        )
      );

      // ====[ posts / comments ]===================================================================
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if (
          isAuthenticated() && request.auth.uid == resource.data.commenterId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["text","updatedAt"])
          && request.resource.data.updatedAt == request.time
        );
        allow delete: if (
          isAuthenticated()
          && (
            isAuthenticated() && request.auth.uid == resource.data.commenterId
            || hasClaim("admin", true)
          )
        );
      } // End of posts / comments
    } // End of posts
  } // End of rules
} // End of service definition"
`;
